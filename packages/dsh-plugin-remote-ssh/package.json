{
  "name": "dsh-plugin-remote-ssh",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: aggregate a remote DSH instance (workspaces and sessions) over an SSH tunnel",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "typescript": "^5.9.0"
  }
}
